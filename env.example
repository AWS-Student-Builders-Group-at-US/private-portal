# Copy to .env.local (git-ignored) and fill in the values. Never commit real values.
# The same names are configured in Vercel → Settings → Environment Variables.

# --- Required to run the app ---------------------------------------------
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Secret key (formerly service_role). Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Any long random string (e.g. `openssl rand -hex 32`); salts IPs for check-in rate limits.
CHECKIN_IP_SALT=
# Public base URL used in emails, QR codes and calendar links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional features (leave empty to disable them locally) ---------------
# Group Gmail (common account): read-only inbox and event emails.
# GMAIL_APP_PASSWORD is a Google *app password* (16 letters), not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Local only: set to 1 to show sample emails in /panel/correo without Gmail credentials.
INBOX_FIXTURES=

# Google Drive folder in Recursos (service account JSON key, base64-encoded).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Zernio (Instagram/LinkedIn planning).
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Daily maintenance cron (/api/cron/diario).
CRON_SECRET=
